# Ruta base de la API. Con el proxy de Vite en desarrollo basta con /api.
# En GitHub Pages funciona automáticamente en modo cliente local (sin necesidad de servidor backend).
# Si despliegas un backend propio (ej. Render/Railway), coloca su URL aquí (ej: https://mi-api.onrender.com/api)
VITE_API_URL=/api

# Destino del proxy de desarrollo (backend local)
VITE_PROXY_TARGET=http://localhost:4000

# Forzar modo cliente local autónomo en cualquier entorno (true/false)
# VITE_STANDALONE=true

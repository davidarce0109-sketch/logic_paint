# Servidor
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Persistencia: mysql (por defecto) o memory (sin base de datos, solo para pruebas)
STORAGE_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=pintar_logic

# Reglas del juego
GAME_DURATION_SECONDS=900
QUESTION_COUNT=15
# linear | forgiving
SCORING_STRATEGY=linear
HINTS_ENABLED=true
